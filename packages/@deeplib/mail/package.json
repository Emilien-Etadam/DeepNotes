  "dependencies": {
    "@getbrevo/brevo": "^1.0.1",
    "@sendgrid/mail": "^8.1.6",
    "@stdlib/misc": "workspace:*",
    "node-mailjet": "^6.0.4",
    "nodemailer": "^6.10.1",
